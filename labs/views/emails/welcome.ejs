<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to Our Platform</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap');
    
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      background-color: #0b0f19;
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #0b0f19;
      padding-bottom: 40px;
      padding-top: 40px;
    }
    
    .main-table {
      background-color: #111827;
      margin: 0 auto;
      width: 100%;
      max-width: 600px;
      border-spacing: 0;
      color: #f3f4f6;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.05);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
    }
    
    .header {
      background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
      padding: 40px 30px;
      text-align: center;
    }
    
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.5px;
    }
    
    .content {
      padding: 40px 30px;
      font-size: 16px;
      line-height: 1.6;
    }
    
    .greeting {
      font-size: 22px;
      font-weight: 600;
      margin-top: 0;
      margin-bottom: 20px;
      color: #ffffff;
    }
    
    .message {
      color: #9ca3af;
      margin-bottom: 30px;
    }
    
    .btn-container {
      text-align: center;
      margin-bottom: 30px;
    }
    
    .btn {
      display: inline-block;
      background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 32px;
      font-size: 16px;
      font-weight: 500;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.2), 0 2px 4px -1px rgba(99, 102, 241, 0.1);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .footer {
      background-color: #0d121f;
      padding: 24px 30px;
      text-align: center;
      font-size: 13px;
      color: #6b7280;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .footer a {
      color: #6366f1;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <center class="wrapper">
    <table class="main-table" width="100%">
      <tr>
        <td class="header">
          <h1>Welcome to Our Platform</h1>
        </td>
      </tr>
      <tr>
        <td class="content">
          <p class="greeting">Hello, <%= name %>!</p>
          <p class="message">
            We are absolutely thrilled to have you join our platform. Explore your workspace, customize your experience, and start building something amazing today.
          </p>
          <div class="btn-container">
            <a href="http://localhost:3000/users/login" class="btn" target="_blank">Sign In to Your Account</a>
          </div>
          <p class="message" style="font-size: 14px; margin-bottom: 0;">
            If the button above doesn't work, copy and paste this URL into your browser: <br>
            <span style="color: #6366f1;">http://localhost:3000/users/login</span>
          </p>
        </td>
      </tr>
      <tr>
        <td class="footer">
          <p style="margin: 0 0 8px 0;">&copy; 2026 Our Platform. All rights reserved.</p>
          <p style="margin: 0;">You're receiving this because you registered an account. <a href="http://localhost:3000/users/login">Visit Sign In</a></p>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
